# DerivaQuant Platform Environment Variables (Example Template)

# Backend Configuration
DERIVAQUANT_DEBUG=false
DERIVAQUANT_SEED=42
DERIVAQUANT_HOST=127.0.0.1
DERIVAQUANT_PORT=8000
DERIVAQUANT_DEMO_MODE=false

# Module 2 Storage & Persistence Configuration
# Mode: "persistent" (default, utilizes database) or "mock" (in-memory mock provider)
DERIVAQUANT_STORAGE_MODE=persistent

# Database Connection URL:
# 1. Local SQLite file (Default, zero setup required):
DATABASE_URL=sqlite:///./derivaquant.db

# 2. Local PostgreSQL via Docker Compose (docker compose up -d):
# DATABASE_URL=postgresql://derivaquant:derivaquant_secret_pw@localhost:5432/derivaquant_db

# Frontend Configuration
VITE_API_URL=/api/v1
